{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(cfn-lint*)",
      "Bash(yamllint*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "find . -maxdepth 1 \\( -name \"*.yaml\" -o -name \"*.yml\" \\) -exec cfn-lint {} + 2>&1 || true"
          },
          {
            "type": "command",
            "command": "find . -maxdepth 1 \\( -name \"*.yaml\" -o -name \"*.yml\" \\) -exec yamllint -d relaxed {} + 2>&1 || true"
          }
        ]
      }
    ]
  }
}
